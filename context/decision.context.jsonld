{
  "@context": {
    "@version": 1.1,
    "dec": "https://w3id.org/decision#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "schema": "https://schema.org/",
    "id": "@id",
    "type": "@type",
    "Decision": "dec:Decision",
    "Option": "dec:Option",
    "label": "http://www.w3.org/2000/01/rdf-schema#label",
    "whyNow": "dec:whyNow",
    "option": {"@id": "dec:option", "@type": "@id", "@container": "@set"},
    "recommendedOption": {"@id": "dec:recommendedOption", "@type": "@id"},
    "chosenOption": {"@id": "dec:chosenOption", "@type": "@id"},
    "deadline": {"@id": "dec:deadline", "@type": "xsd:dateTime"},
    "nature": {"@id": "dec:nature", "@type": "@vocab"},
    "reversibility": {"@id": "dec:reversibility", "@type": "@vocab"},
    "factualBasis": {"@id": "dec:factualBasis", "@type": "@vocab"},
    "requiredOversight": {"@id": "dec:requiredOversight", "@type": "@vocab"},
    "outcome": {"@id": "dec:outcome", "@type": "@vocab"},
    "magnitude": {"@id": "dec:magnitude", "@type": "@id"},
    "value": {"@id": "schema:value", "@type": "xsd:decimal"},
    "unit": "schema:unitText",
    "affectsThirdParty": {"@id": "dec:affectsThirdParty", "@type": "xsd:boolean"},
    "legalEffect": {"@id": "dec:legalEffect", "@type": "xsd:boolean"},
    "classifiedUnder": {"@id": "dec:classifiedUnder", "@type": "@id"},
    "classifiedBy": {"@id": "dec:classifiedBy", "@type": "@id"},
    "recordedIn": {"@id": "dec:recordedIn", "@type": "@id", "@container": "@set"},
    "Alert": "dec:Alert",
    "Validation": "dec:Validation",
    "Arbitration": "dec:Arbitration",
    "Reversible": "dec:Reversible",
    "Compensable": "dec:Compensable",
    "Irreversible": "dec:Irreversible",
    "SourcesRead": "dec:SourcesRead",
    "SourcesCited": "dec:SourcesCited",
    "Unsourced": "dec:Unsourced",
    "NoApproval": "dec:NoApproval",
    "Confirmation": "dec:Confirmation",
    "Signature": "dec:Signature",
    "Approved": "dec:Approved",
    "Amended": "dec:Amended",
    "Refused": "dec:Refused",
    "Deferred": "dec:Deferred"
  }
}
